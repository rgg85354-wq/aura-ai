# Copy this file to .env and fill in the values.

# --- Claude (required for chat, code and ideas) ---
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Model used for every reply
AURA_MODEL=claude-opus-5-5

# --- Image generation (required for the "Images" screen) ---
# Any service with an OpenAI-compatible POST /images/generations endpoint.
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# --- Server ---
PORT=8787
HOST=0.0.0.0
# Where the database and uploaded files are stored
DATA_DIR=data

# --- Daily limits ---
FREE_DAILY_MESSAGES=30
FREE_DAILY_IMAGES=5
PRO_DAILY_MESSAGES=1000
PRO_DAILY_IMAGES=100
MAX_UPLOAD_MB=20

# --- Aura Pro subscription ---
# true = trust purchases without checking them with Apple/Google.
# Use ONLY while testing with Xcode StoreKit files or Play license testers.
PRO_TEST_MODE=false

# Apple: put AppleRootCA-G3.cer (https://www.apple.com/certificateauthority/) into server/certs
APPLE_BUNDLE_ID=com.aura.ai
APPLE_ENVIRONMENT=Sandbox
# Numeric App Store app id, required when APPLE_ENVIRONMENT=Production
APPLE_APP_ID=

# Google Play: service account JSON with access to the Play Developer API
GOOGLE_PACKAGE_NAME=com.aura.ai
GOOGLE_SERVICE_ACCOUNT_FILE=
