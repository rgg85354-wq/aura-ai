<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed so the app can reach a server on your local network while testing.
     For a public release, serve the API over HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
